load("@rules_rust//rust:defs.bzl", "rust_binary", "rustfmt_test", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "main",
    srcs = ["src/main.rs"],
    deps = [
        ":compiler",
        ":memory_manager",
        ":virtual_machine",
        ":scanner",
        "@crates//:ariadne",
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_library(
    name = "scanner",
    srcs = ["src/scanner.rs"],
    deps = [
        "@crates//:ariadne",
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_library(
    name = "parser",
    srcs = ["src/parser.rs"],
    deps = [
        ":scanner",
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_library(
    name = "chunk",
    srcs = ["src/chunk.rs"],
    deps = [
        "@crates//:ariadne",
        ":scanner",
        "@crates//:slotmap"
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_library(
    name = "virtual_machine",
    srcs = ["src/virtual_machine.rs"],
    deps = [
        ":chunk",
        ":memory_manager",
        ":scanner",
        "@crates//:serde_json",
        "@crates//:slotmap"
    ],
    crate_features = [
        "stress_gc",
        "gc_debug",
    ]
)

rust_library(
    name = "memory_manager",
    srcs = ["src/memory_manager.rs"],
    deps = [
        "@crates//:slotmap",
        ":chunk",
    ],
    crate_features = [
        "stress_gc",
        "gc_debug",
    ]
)

rust_library(
    name = "compiler",
    srcs = ["src/compiler.rs", "src/compiler_integration_test.rs"],
    deps = [
        ":chunk",
        ":scanner",
        ":parser",
        ":memory_manager",
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_test(
    name = "scanner_test",
    crate = ":scanner"
)

rust_test(
    name = "parser_test",
    crate = ":parser"
)

rust_test(
    name = "chunk_test",
    crate = ":chunk"
)

rust_test(
    name = "virtual_machine_test",
    crate = ":virtual_machine"
)

rust_test(
    name = "compiler_test",
    crate = ":compiler"
)

rust_test(
    name = "memory_manager_test",
    crate = ":memory_manager",
)

rustfmt_test(
    name = "format_test",
    targets = [
        ":compiler",
        ":virtual_machine",
        ":scanner",
        ":parser",
        ":chunk",
        ":memory_manager"
    ],
)

sh_test(
    name = "jsonnet_validation_test",
     srcs = ["test_runner.sh"],

     data = glob(["end2end/*.jsonnet"]) + [
        ":main",
    ],

    # We set this to true to ensure the test is executed.
    local = True,
    # CRITICAL: Add timeout to catch infinite loops in end2end tests (hq-uxnq)
    timeout = "short",
)

# Positive tests - tests that should pass (hq-qojx)
sh_test(
    name = "jsonnet_validation_test_positive",
    srcs = ["test_runner_positive.sh"],
    data = glob(["end2end/*.jsonnet"]) + [
        ":main",
    ],
    local = True,
    timeout = "short",
)

# Negative tests - tests that should fail (hq-qojx)
sh_test(
    name = "jsonnet_validation_test_negative",
    srcs = ["test_runner_negative.sh"],
    data = glob(["end2end/*.jsonnet"]) + [
        ":main",
    ],
    local = True,
    timeout = "short",
)

# Output validation test - validates results against expected outputs (hq-ebal)
sh_test(
    name = "jsonnet_validation_test_with_output",
    srcs = ["test_with_validation.sh"],
    data = glob(["end2end/*.jsonnet"]) + glob(["end2end/*.expected"]) + [
        ":main",
    ],
    local = True,
    timeout = "short",
)

# Concurrent test runner - runs positive and negative tests in parallel (hq-gipl)
sh_test(
    name = "jsonnet_validation_test_concurrent",
    srcs = ["test_runner_concurrent.sh"],
    data = glob(["end2end/*.jsonnet"]) + [
        ":main",
    ],
    local = True,
    timeout = "short",
)
