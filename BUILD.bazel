load("@rules_rust//rust:defs.bzl", "rust_binary", "rustfmt_test", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "main",
    srcs = ["src/main.rs"],
    deps = [
        ":compiler",
        ":memory_manager",
        ":virtual_machine",
        ":scanner",
        "@crates//:ariadne",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "main_stress",
    srcs = ["src/main.rs"],
    deps = [
        ":compiler_stress",
        ":memory_manager_stress",
        ":virtual_machine_stress",
        ":scanner",
        "@crates//:ariadne",
        "@crates//:serde_json",
    ],
)

rust_library(
    name = "scanner",
    srcs = ["src/scanner.rs"],
    deps = [
        "@crates//:ariadne",
    ],
)

rust_library(
    name = "parser",
    srcs = ["src/parser.rs"],
    deps = [
        ":scanner",
    ],
)

rust_library(
    name = "chunk",
    srcs = ["src/chunk.rs"],
    deps = [
        "@crates//:ariadne",
        ":scanner",
        "@crates//:slotmap"
    ],
)

rust_library(
    name = "virtual_machine",
    srcs = ["src/virtual_machine.rs"],
    deps = [
        ":chunk",
        ":compiler",
        ":coverage",
        ":memory_manager",
        ":scanner",
        ":native",
        ":serialized_chunk",
        "@crates//:serde_json",
        "@crates//:serde_yaml",
        "@crates//:slotmap"
    ],
)

rust_library(
    name = "virtual_machine_stress",
    crate_name = "virtual_machine",
    srcs = ["src/virtual_machine.rs"],
    deps = [
        ":chunk",
        ":compiler_stress",
        ":coverage",
        ":memory_manager_stress",
        ":scanner",
        ":native_stress",
        ":serialized_chunk_stress",
        "@crates//:serde_json",
        "@crates//:serde_yaml",
        "@crates//:slotmap"
    ],
)

rust_library(
    name = "native",
    srcs = ["src/native.rs"],
    deps = [
        ":chunk",
        ":memory_manager",
        "@crates//:md5",
        "@crates//:sha2",
        "@crates//:sha1",
        "@crates//:sha3",
    ],
)

rust_library(
    name = "native_stress",
    crate_name = "native",
    srcs = ["src/native.rs"],
    deps = [
        ":chunk",
        ":memory_manager_stress",
        "@crates//:md5",
        "@crates//:sha2",
        "@crates//:sha1",
        "@crates//:sha3",
    ],
)

rust_library(
    name = "memory_manager_stress",
    crate_name = "memory_manager",
    srcs = ["src/memory_manager.rs"],
    deps = [
        "@crates//:slotmap",
        ":chunk",
    ],
    crate_features = [
        "stress_gc",
    ]
)

rust_library(
    name = "memory_manager",
    srcs = ["src/memory_manager.rs"],
    deps = [
        "@crates//:slotmap",
        ":chunk",
    ],
)

rust_library(
    name = "compiler",
    srcs = ["src/compiler.rs"],
    deps = [
        ":chunk",
        ":scanner",
        ":parser",
        ":memory_manager",
    ],
)

rust_library(
    name = "compiler_stress",
    crate_name = "compiler",
    srcs = ["src/compiler.rs"],
    deps = [
        ":chunk",
        ":scanner",
        ":parser",
        ":memory_manager_stress",
    ],
)

rust_library(
    name = "serialized_chunk",
    srcs = ["src/serialized_chunk.rs"],
    deps = [
        ":chunk",
        ":memory_manager",
        "@crates//:fory",
        "@crates//:fory-core",
        "@crates//:slotmap",
    ],
    proc_macro_deps = [
        "@crates//:fory-derive",
    ],
)

rust_library(
    name = "serialized_chunk_stress",
    crate_name = "serialized_chunk",
    srcs = ["src/serialized_chunk.rs"],
    deps = [
        ":chunk",
        ":memory_manager_stress",
        "@crates//:fory",
        "@crates//:fory-core",
        "@crates//:slotmap",
    ],
    proc_macro_deps = [
        "@crates//:fory-derive",
    ],
)

rust_library(
    name = "coverage",
    srcs = ["src/coverage.rs"],
)

rust_library(
    name = "test_reporter",
    srcs = ["src/test_reporter.rs"],
)

rust_library(
    name = "lcov",
    srcs = ["src/lcov.rs"],
    deps = [
        ":coverage",
    ],
)

rust_library(
    name = "test_runner",
    srcs = ["src/test_runner.rs"],
    deps = [
        ":chunk",
        ":coverage",
        ":memory_manager",
        ":test_reporter",
        ":virtual_machine",
        "@crates//:ariadne",
    ],
)

rust_binary(
    name = "jsonnet_compiler",
    srcs = ["src/jsonnet_compiler.rs"],
    deps = [
        ":compiler",
        ":memory_manager",
        ":scanner",
        ":serialized_chunk",
        ":chunk",
    ],
)

rust_binary(
    name = "jsonnet_test_runner",
    srcs = ["src/jsonnet_test_runner.rs"],
    deps = [
        ":compiler",
        ":coverage",
        ":lcov",
        ":memory_manager",
        ":scanner",
        ":test_reporter",
        ":test_runner",
        ":virtual_machine",
    ],
)

rust_test(
    name = "scanner_test",
    crate = ":scanner"
)

rust_test(
    name = "parser_test",
    crate = ":parser"
)

rust_test(
    name = "chunk_test",
    crate = ":chunk"
)

rust_test(
    name = "virtual_machine_test",
    crate = ":virtual_machine"
)

rust_test(
    name = "compiler_test",
    crate = ":compiler"
)

rust_test(
    name = "memory_manager_test",
    crate = ":memory_manager",
)

rust_test(
    name = "native_test",
    crate = ":native",
)

rust_test(
    name = "serialized_chunk_test",
    crate = ":serialized_chunk",
)

rust_test(
    name = "coverage_test",
    crate = ":coverage"
)

rust_test(
    name = "lcov_test",
    crate = ":lcov",
)

rust_test(
    name = "test_reporter_test",
    crate = ":test_reporter"
)

rustfmt_test(
    name = "format_test",
    targets = [
        ":compiler",
        ":virtual_machine",
        ":scanner",
        ":parser",
        ":chunk",
        ":memory_manager",
        ":native",
        ":serialized_chunk",
        ":jsonnet_compiler",
        ":coverage",
        ":lcov",
        ":test_reporter",
        ":test_runner",
        ":jsonnet_test_runner",
    ],
)
