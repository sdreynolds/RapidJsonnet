load("@rules_rust//rust:defs.bzl", "rust_binary", "rustfmt_test", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "main",
    srcs = ["src/main.rs"],
    deps = [
        ":compiler",
        ":memory_manager",
        ":virtual_machine",
        ":scanner",
        "@crates//:ariadne",
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_library(
    name = "scanner",
    srcs = ["src/scanner.rs"],
    deps = [
        "@crates//:ariadne",
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_library(
    name = "parser",
    srcs = ["src/parser.rs"],
    deps = [
        ":scanner",
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_library(
    name = "chunk",
    srcs = ["src/chunk.rs"],
    deps = [
        "@crates//:ariadne",
        ":scanner",
        "@crates//:slotmap"
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_library(
    name = "virtual_machine",
    srcs = ["src/virtual_machine.rs"],
    deps = [
        ":chunk",
        ":compiler",
        ":memory_manager",
        ":scanner",
        ":native",
        "@crates//:serde_json",
        "@crates//:slotmap"
    ],
    crate_features = [
        "stress_gc",
        "gc_debug",
    ]
)

rust_library(
    name = "native",
    srcs = ["src/native.rs"],
    deps = [
        ":chunk",
        ":memory_manager",
    ],
    crate_features = [
        "stress_gc",
        "gc_debug",
    ]
)

rust_library(
    name = "memory_manager",
    srcs = ["src/memory_manager.rs"],
    deps = [
        "@crates//:slotmap",
        ":chunk",
    ],
    crate_features = [
        "stress_gc",
        "gc_debug",
    ]
)

rust_library(
    name = "compiler",
    srcs = ["src/compiler.rs", "src/compiler_integration_test.rs"],
    deps = [
        ":chunk",
        ":scanner",
        ":parser",
        ":memory_manager",
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_test(
    name = "scanner_test",
    crate = ":scanner"
)

rust_test(
    name = "parser_test",
    crate = ":parser"
)

rust_test(
    name = "chunk_test",
    crate = ":chunk"
)

rust_test(
    name = "virtual_machine_test",
    crate = ":virtual_machine"
)

rust_test(
    name = "compiler_test",
    crate = ":compiler"
)

rust_test(
    name = "memory_manager_test",
    crate = ":memory_manager",
)

rustfmt_test(
    name = "format_test",
    targets = [
        ":compiler",
        ":virtual_machine",
        ":scanner",
        ":parser",
        ":chunk",
        ":memory_manager",
        ":native"
    ],
)


