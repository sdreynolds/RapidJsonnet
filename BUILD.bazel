load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "main",
    srcs = ["src/main.rs"],
    deps = [
        ":compiler",
        ":virtual_machine",
        ":scanner",
        ":string_pool",
        "@crates//:ariadne",
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_library(
    name = "scanner",
    srcs = ["src/scanner.rs"],
    deps = [
        "@crates//:ariadne",
        ":string_pool"
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_library(
    name = "parser",
    srcs = ["src/parser.rs"],
    deps = [
        ":scanner",
        ":string_pool",
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_library(
    name = "chunk",
    srcs = ["src/chunk.rs"],
    deps = [
        "@crates//:ariadne",
        ":scanner",
        ":string_pool",
        "@crates//:slotmap"
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_library(
    name = "virtual_machine",
    srcs = ["src/virtual_machine.rs"],
    deps = [
        ":chunk",
        ":scanner",
        ":string_pool",
        "@crates//:serde_json",
        "@crates//:slotmap"
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_library(
    name = "string_pool",
    srcs = ["src/string_pool.rs"],
    deps = [],
    crate_features = [
        "stress_gc"
    ]
)

rust_library(
    name = "compiler",
    srcs = ["src/compiler.rs", "src/compiler_integration_test.rs"],
    deps = [
        ":chunk",
        ":scanner",
        ":parser",
        ":string_pool",
    ],
    crate_features = [
        "stress_gc"
    ]
)

rust_test(
    name = "scanner_test",
    crate = ":scanner"
)

rust_test(
    name = "parser_test",
    crate = ":parser"
)

rust_test(
    name = "chunk_test",
    crate = ":chunk"
)

rust_test(
    name = "virtual_machine_test",
    crate = ":virtual_machine"
)

rust_test(
    name = "compiler_test",
    crate = ":compiler"
)

rust_test(
    name = "string_pool_test",
    crate = ":string_pool"
)
